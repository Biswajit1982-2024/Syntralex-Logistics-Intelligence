# Copy to .env for local overrides, or set these as real environment
# variables on your hosting platform (Render reads render.yaml for most of
# this automatically — see render.yaml).

# "production" enables Secure session cookies, HSTS, and hides the demo
# login buttons. Leave unset (or "development") for local use.
NODE_ENV=development

PORT=4000

# Where the SQLite DB and uploaded files are stored. Leave unset locally —
# defaults to server/data and server/uploads next to the code. On a host
# with a persistent disk, point this at the mounted path.
# STORAGE_DIR=/var/data

# Password every seeded demo account gets. Leave unset locally to use the
# default (Freight@123, shown on the login screen). In production, set this
# to a real generated secret — render.yaml does this automatically — which
# also switches off the one-click demo-login buttons in the UI.
# SEED_DEMO_PASSWORD=
